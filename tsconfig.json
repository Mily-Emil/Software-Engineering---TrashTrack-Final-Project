{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "baseUrl": "./TrashTrack",
    "paths": {
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"],
      "https://esm.sh/@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["TrashTrack/src", "TrashTrack/supabase"]
}

