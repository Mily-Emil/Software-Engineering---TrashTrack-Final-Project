VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Hanya dipasang di sisi Server (.env lokal tanpa VITE_ atau Supabase Edge Function Secrets — NFR-02):
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite


# Google Maps JavaScript API (boleh di sisi klien; batasi dengan HTTP referrer di Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Opsional: Map ID dari Google Cloud (untuk Advanced Markers). Default: DEMO_MAP_ID
VITE_GOOGLE_MAPS_MAP_ID=
